{
  "name": "AutoVerse",
  "short_name": "AutoVerse",
  "description": "Premium automotive discovery, comparisons, ownership tools, and automotive insights.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#05070a",
  "theme_color": "#05070a",
  "categories": ["automotive", "lifestyle", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Fleet Catalog",
      "short_name": "Fleet",
      "description": "Explore verified supercars and premium automotive machines",
      "url": "/",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Vehicle Comparison",
      "short_name": "Compare",
      "description": "Side-by-side technical telemetry and specs benchmark",
      "url": "/compare",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Road Cinema",
      "short_name": "Cinema",
      "description": "Ultra-HD cinematic exhaust soundscapes and visual reel",
      "url": "/cinema",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Car Financing & EMI",
      "short_name": "Financing",
      "description": "Reducing-balance loan calculation and scenario comparison",
      "url": "/financing",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
